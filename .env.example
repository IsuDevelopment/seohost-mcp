# Local default. Production: use the public HTTPS MCP URL and HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
MCP_CONFIG_FILE=config/servers.example.json
# At least 32 characters. Generate locally with npm run setup:local.
MCP_AUTH_TOKEN=
# Optional separate write-capable Bearer token; never reuse MCP_AUTH_TOKEN.
# OAuth users request mcp:read mcp:write instead. Accounts also need writeOperations.
MCP_WRITE_AUTH_TOKEN=
MCP_CHANGE_STATE_FILE=data/changes.sqlite
# Optional OAuth. All three required when enabling OAuth; token auth may coexist.
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_SUBJECTS=
# Extra browser origins, comma separated; no wildcard. Requests without Origin work.
MCP_ALLOWED_ORIGINS=
# Hosting credentials. Configure privately with npm run setup:hosting.
SEOHOST_PRIMARY_USERNAME=
SEOHOST_PRIMARY_LOGIN_KEY=
SEOHOST_SECONDARY_USERNAME=
SEOHOST_SECONDARY_LOGIN_KEY=

# Self-hosted OAuth: alternative to the external JWT provider above.
# Configure with: npm run setup:oauth -- .env
MCP_LOCAL_OAUTH=false
MCP_OWNER_USERNAME=
MCP_OWNER_PASSWORD_HASH=
MCP_OAUTH_REDIRECT_URIS=
MCP_OAUTH_STATE_FILE=data/oauth.sqlite
