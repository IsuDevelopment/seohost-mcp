{
  "name": "seohost-mcp",
  "version": "0.10.0",
  "description": "SeoHost shared-hosting MCP: logs, domains, DNS diagnostics and reviewed changes via DirectAdmin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/http.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/http.js",
    "start:stdio": "node --env-file-if-exists=.env dist/src/stdio.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "setup:local": "node scripts/setup-local.mjs",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "download:database": "node --env-file-if-exists=.env scripts/download-database.mjs",
    "smoke:hosting": "node --env-file-if-exists=.env scripts/smoke-hosting.mjs",
    "setup:oauth": "node scripts/setup-oauth.mjs",
    "setup:hosting": "node scripts/setup-hosting.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "^6.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
